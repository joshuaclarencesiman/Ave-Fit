DB_HOST=localhost
DB_PORT=5432
DB_NAME=avefit_restore
DB_USER=postgres
DB_PASSWORD=Leighzy_03
PORT=5000

# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# OAuth web client ID shared with the frontend. Configure authorized JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=

# Origins allowed to call this API (comma separated).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Public client URL retained for previously issued verification links.
CLIENT_URL=http://localhost:5173

# SMTP for the signup verification email.
# Gmail:    SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
#           as SMTP_PASS with SMTP_SECURE=false.
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank and the server prints the
# verification code to the console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Code lifetime, legacy link lifetime, and minimum gap between resends.
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_TTL_MINUTES=1440
VERIFICATION_RESEND_COOLDOWN_MINUTES=2
